# Адреса для скана. Правь этот файл, в консоль их писать не нужно.
# Пустые строки не читаются. То, что уже задано в окне PowerShell, важнее файла.

# Qwen Ильи в LAN: без ключа и без имени модели
VISION_API_BASE_URL=http://192.168.4.101:8080
INGEST_VISION_MAX_LONG_EDGE=2560
INGEST_VISION_REASONING=off

# Адрес dots, который дали. Пока пусто — разметка идёт без dots (в консоли: dots off).
SCAN_DOTS_URL=
# Если сервер требует имя — id из GET {SCAN_DOTS_URL}/v1/models. Пусто — сервер сам берёт загруженную модель.
SCAN_DOTS_MODEL=

# Необязательная подсказка Chandra 2 для Qwen. Пустая строка не читается.
# Флаг --chandra без адреса предупреждает и идёт как без флага. Облако не вызывать.
# Локальный vLLM (chandra_vllm), формат как у VISION: http://127.0.0.1:8000/v1
SCAN_CHANDRA_URL=
